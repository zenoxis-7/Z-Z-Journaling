<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>XAUUSD · Trade Journal</title>
<style>
:root{--bg:#151515;--panel:#191919;--panel2:#202020;--line:#303030;--text:#f2f2f2;--muted:#999;--green:#38e58b;--red:#ff6464;--amber:#e5c77b}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.top{height:64px;border-bottom:1px solid #292929;display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;background:#151515ee;backdrop-filter:blur(12px);z-index:20}
.brand{font-size:14px;font-weight:700}.updated{font-size:11px;color:#888;margin-left:10px}.top-actions{display:flex;gap:8px}
.btn{border:1px solid #373737;background:#222;color:#eee;border-radius:8px;padding:8px 12px;font-size:11px}.btn:hover{background:#292929}.btn.primary{background:#eee;color:#111;border-color:#eee}.btn.danger{color:#ff8585}
.wrap{max-width:1120px;margin:auto;padding:30px 18px 70px}
.heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.period{color:#aaa;font-size:12px}.instrument{font-size:10px;letter-spacing:2px;font-weight:700}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.select{background:#202020;color:#eee;border:1px solid #353535;border-radius:8px;padding:9px 11px;font-size:11px}
.stats{display:grid;grid-template-columns:1fr 1.8fr 1fr 1fr 1fr;gap:9px}.stat{border:1px solid var(--line);border-radius:10px;padding:16px}.stat span{display:block;color:#9b9b9b;font-size:10px;margin-bottom:10px}.stat b{font-size:21px}
.note{font-size:10px;color:#888;margin:13px 0 28px}.section-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.section-row h2{font-size:16px;margin:0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.card{border:1px solid var(--line);border-radius:10px;padding:15px;background:#181818}.cardhead{display:flex;justify-content:space-between;align-items:center}.title{font-size:13px;font-weight:650}.more{color:#777}
.meta{display:flex;justify-content:space-between;align-items:center;margin:16px 0 10px}.badge{font-size:9px;padding:6px 8px;border-radius:4px;background:#292929;color:#ddd}.badge.tp{background:#153b29;color:var(--green)}.badge.sl{background:#452020;color:var(--red)}
.pips{font-size:17px;font-weight:700}.pips.tp{color:var(--green)}.pips.sl{color:var(--red)}
.image{border:1px solid #2c2c2c;border-radius:5px;overflow:hidden;background:#050505}.image img{width:100%;display:block;aspect-ratio:1.9/1;object-fit:cover}
.levels{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:15px}.levels span{display:block;color:#888;font-size:9px;margin-bottom:5px}.levels b{font-size:13px}
.reason,.setup,.notes{font-size:10px;color:#969696;line-height:1.5;margin:13px 0 0}.reason strong,.setup strong{color:#cfcfcf}
.card-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:13px}
.empty{border:1px solid var(--line);border-radius:10px;padding:35px;text-align:center;color:#777;display:none}

.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:18px;z-index:50}.modal.show{display:flex}.dialog{width:min(720px,100%);max-height:92vh;overflow:auto;background:#181818;border:1px solid #363636;border-radius:12px;padding:20px}
.dialog h3{margin:0 0 16px;font-size:16px}.form{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.field.full{grid-column:1/-1}.field label{display:block;color:#999;font-size:10px;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;background:#111;color:#eee;border:1px solid #353535;border-radius:7px;padding:9px;font-size:12px}.field textarea{min-height:80px;resize:vertical}.field input[type=file]{padding:7px}.preview{margin-top:8px;max-height:180px;max-width:100%;border-radius:6px;border:1px solid #333;display:none}
.dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.hint{font-size:9px;color:#777;margin-top:6px}
.toast{position:fixed;bottom:20px;right:20px;background:#eee;color:#111;border-radius:8px;padding:10px 13px;font-size:11px;display:none;z-index:100}.toast.show{display:block}

@media(max-width:820px){.stats{grid-template-columns:1fr 1fr}.stats .stat:nth-child(2){grid-column:span 2}.grid{grid-template-columns:1fr}.form{grid-template-columns:1fr}.field.full{grid-column:auto}.top{padding:0 14px}.updated{display:none}}
</style>
</head>
<body>
<header class="top">
  <div><span class="brand">XAUUSD · Trade journal</span><span class="updated" id="updated"></span></div>
  <div class="top-actions">
    <button class="btn" id="exportBtn">Export</button>
    <button class="btn" id="importBtn">Import</button>
    <input id="importFile" type="file" accept=".json" hidden>
    <button class="btn primary" id="addBtn">+ Add trade</button>
  </div>
</header>

<main class="wrap">
  <div class="heading"><div class="period" id="period"></div><div class="instrument">GOLD / XAUUSD</div></div>
  <div class="filters">
    <select class="select" id="dateFilter"><option value="all">Trading day · All dates</option></select>
    <select class="select" id="outcomeFilter"><option value="all">Outcome · All</option><option>Full TP</option><option>Break-even</option><option>Stop loss</option></select>
    <select class="select" id="sideFilter"><option value="all">Side · All</option><option>Buy</option><option>Sell</option></select>
  </div>

  <section class="stats">
    <div class="stat"><span>Trades</span><b id="count">0</b></div>
    <div class="stat"><span>Recorded net pips</span><b id="net">0</b></div>
    <div class="stat"><span>Full TP</span><b id="tp">0</b></div>
    <div class="stat"><span>Break-even</span><b id="be">0</b></div>
    <div class="stat"><span>Stop loss</span><b id="sl">0</b></div>
  </section>
  <div class="note">Local journal: records and uploaded chart images are stored in this browser. Use Export to create a backup before moving devices.</div>

  <div class="section-row"><h2>Trades &amp; charts</h2><button class="btn" id="clearFilters">Clear filters</button></div>
  <section class="grid" id="grid"></section>
  <div class="empty" id="empty">No trades match the selected filters.</div>
</main>

<div class="modal" id="modal">
 <div class="dialog">
  <h3 id="modalTitle">Add trade</h3>
  <form id="tradeForm">
   <input type="hidden" id="editId">
   <div class="form">
    <div class="field"><label>Date</label><input id="fDate" type="date" required></div>
    <div class="field"><label>Side</label><select id="fSide"><option>Buy</option><option>Sell</option></select></div>
    <div class="field"><label>Outcome</label><select id="fOutcome"><option>Full TP</option><option>Break-even</option><option>Stop loss</option></select></div>
    <div class="field"><label>Recorded pips</label><input id="fPips" type="number" step="0.1" value="0" required></div>
    <div class="field"><label>Entry</label><input id="fEntry" type="number" step="0.01"></div>
    <div class="field"><label>Stop loss</label><input id="fSL" type="number" step="0.01"></div>
    <div class="field"><label>Take profit</label><input id="fTP" type="number" step="0.01"></div>
    <div class="field"><label>Trade number <span class="hint">(optional; auto if blank)</span></label><input id="fNum" type="number" min="1"></div>
    <div class="field full"><label>Reason / why the trade was taken</label><textarea id="fReason" placeholder="Example: CHOCH, zone reaction, news context, etc."></textarea></div>
    <div class="field full"><label>Setup / confluence</label><textarea id="fSetup" placeholder="Add the setup, levels, timeframe, or other context."></textarea></div>
    <div class="field full"><label>Notes / result details</label><textarea id="fNotes" placeholder="Anything important about execution or the result."></textarea></div>
    <div class="field full"><label>Chart image</label><input id="fImage" type="file" accept="image/*"><img class="preview" id="preview"></div>
   </div>
   <div class="dialog-actions"><button type="button" class="btn" id="cancelBtn">Cancel</button><button type="submit" class="btn primary">Save trade</button></div>
  </form>
 </div>
</div>
<div class="toast" id="toast"></div>

<script>
const SEED = [{"id": "28-1", "date": "2026-09-28", "side": "Sell", "outcome": "Full TP", "entry": 4205, "sl": 4210, "tp": 4163, "pips": 430, "reason": "", "setup": "", "notes": "Full TP hit. Reported +430 pips; written entry/levels imply +420 pips at 0.10 pip, so the recorded result follows the reported figure.", "image": "data:image/jpeg;base64,"}, {"id": "28-2", "date": "2026-09-28", "side": "Sell", "outcome": "Break-even", "entry": 4147, "sl": 4152, "tp": 4137, "pips": 0, "reason": "", "setup": "", "notes": "Reached +60 pips before break-even, per chart annotation. Not booked as profit.", "image": "data:image/jpeg;base64,"}, {"id": "28-3", "date": "2026-09-28", "side": "Sell", "outcome": "Full TP", "entry": 4163, "sl": 4168, "tp": 4153, "pips": 100, "reason": "", "setup": "", "notes": "Full target hit, per chart annotation.", "image": "data:image/jpeg;base64,"}, {"id": "28-4", "date": "2026-09-28", "side": "Buy", "outcome": "Break-even", "entry": 4152, "sl": 4143, "tp": 4158, "pips": 0, "reason": "", "setup": "", "notes": "Corrected by Sattar: break-even, not full TP. Original chart text was superseded by the correction.", "image": "data:image/jpeg;base64,"}, {"id": "29-1", "date": "2026-09-29", "side": "Sell", "outcome": "Stop loss", "entry": 4141, "sl": 4146, "tp": 4131, "pips": -50, "reason": "News and sideways price action during the London session", "setup": "", "notes": "SL hit. Recorded loss: 50 pips.", "image": "data:image/jpeg;base64,"}, {"id": "30-1", "date": "2026-09-30", "side": "Buy", "outcome": "Full TP", "entry": 4174, "sl": 4169, "tp": 4184, "pips": 100, "reason": "", "setup": "", "notes": "Full TP hit, +100 pips, as annotated.", "image": "data:image/jpeg;base64,"}, {"id": "2026-10-01-1", "date": "2026-10-01", "num": "1", "side": "Buy", "outcome": "Stop loss", "entry": 4145, "sl": 4139, "tp": 4156, "pips": 0, "reason": "", "setup": "", "notes": "SL hit — 0 pips, as recorded on the chart.", "image": "data:image/jpeg;base64,"}, {"id": "2026-10-01-2", "date": "2026-10-01", "num": "2", "side": "Sell", "outcome": "Break-even", "entry": 4174, "sl": 4178, "tp": 4164, "pips": 0, "reason": "", "setup": "", "notes": "Breakeven hit — 0 pips, as recorded on the chart.", "image": "data:image/jpeg;base64,"}, {"id": "2026-10-01-3", "date": "2026-10-01", "num": "3", "side": "Sell", "outcome": "Break-even", "entry": 4180, "sl": 4185, "tp": 4170, "pips": 0, "reason": "CHOCH", "setup": "", "notes": "Breakeven hit — 0 pips, as recorded on the chart.", "image": "data:image/jpeg;base64,"}];
let trades = JSON.parse(localStorage.getItem("xauusd_journal_v2") || "null") || SEED;
let selectedImage = null;

const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function save(){ localStorage.setItem("xauusd_journal_v2", JSON.stringify(trades)); }
function niceDate(d){ const x=new Date(d+"T00:00:00"); return x.toLocaleDateString(undefined,{day:"2-digit",month:"short"}); }
function longDate(d){ const x=new Date(d+"T00:00:00"); return x.toLocaleDateString(undefined,{day:"2-digit",month:"long",year:"numeric"}); }
function outcomeClass(o){ return o==="Full TP"?"tp":o==="Stop loss"?"sl":"be"; }
function formatPips(n){ n=Number(n)||0; return n>0?`+${n} pips`:`${n} pips`; }

function refreshFilters(){
 const current=$("dateFilter").value;
 const dates=[...new Set(trades.map(t=>t.date))].sort().reverse();
 $("dateFilter").innerHTML='<option value="all">Trading day · All dates</option>'+dates.map(d=>`<option value="${esc(d)}">${esc(niceDate(d))}</option>`).join("");
 if(dates.includes(current)) $("dateFilter").value=current;
}
function filtered(){
 const d=$("dateFilter").value,o=$("outcomeFilter").value,s=$("sideFilter").value;
 return trades.filter(t=>(d==="all"||t.date===d)&&(o==="all"||t.outcome===o)&&(s==="all"||t.side===s));
}
function render(){
 refreshFilters();
 const list=filtered();
 $("count").textContent=list.length;
 const net=list.reduce((a,t)=>a+(Number(t.pips)||0),0);
 $("net").textContent=(net>=0?"+":"")+net;
 $("tp").textContent=list.filter(t=>t.outcome==="Full TP").length;
 $("be").textContent=list.filter(t=>t.outcome==="Break-even").length;
 $("sl").textContent=list.filter(t=>t.outcome==="Stop loss").length;
 $("period").textContent=trades.length?`${niceDate([...trades].sort((a,b)=>a.date.localeCompare(b.date))[0].date)} – ${niceDate([...trades].sort((a,b)=>a.date.localeCompare(b.date)).at(-1).date)} ${new Date([...trades].sort((a,b)=>a.date.localeCompare(b.date)).at(-1).date+"T00:00:00").getFullYear()}`:"No trades recorded";
 $("updated").textContent="Updated "+new Date().toLocaleDateString(undefined,{day:"2-digit",month:"short",year:"numeric"});
 $("grid").innerHTML=list.map(t=>`
  <article class="card">
   <div class="cardhead"><div class="title">${esc(niceDate(t.date))} · Trade ${esc(t.num||"")} · ${esc(t.side)}</div><div class="more">•••</div></div>
   <div class="meta"><span class="badge ${outcomeClass(t.outcome)}">${esc(t.outcome)}</span><strong class="pips ${outcomeClass(t.outcome)}">${formatPips(t.pips)}</strong></div>
   ${t.image?`<div class="image"><img src="${t.image}" alt="Trade chart"></div>`:""}
   <div class="levels">
    <div><span>Entry</span><b>${t.entry!==""&&t.entry!=null?Number(t.entry).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}):"—"}</b></div>
    <div><span>Stop loss</span><b>${t.sl!==""&&t.sl!=null?Number(t.sl).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}):"—"}</b></div>
    <div><span>Take profit</span><b>${t.tp!==""&&t.tp!=null?Number(t.tp).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}):"—"}</b></div>
   </div>
   ${t.reason?`<p class="reason"><strong>Reason:</strong> ${esc(t.reason)}</p>`:""}
   ${t.setup?`<p class="setup"><strong>Setup:</strong> ${esc(t.setup)}</p>`:""}
   ${t.notes?`<p class="notes">${esc(t.notes)}</p>`:""}
   <div class="card-actions"><button class="btn" onclick="editTrade('${t.id}')">Edit</button><button class="btn danger" onclick="deleteTrade('${t.id}')">Delete</button></div>
  </article>`).join("");
 $("empty").style.display=list.length?"none":"block";
}
function openAdd(){
 $("modalTitle").textContent="Add trade"; $("editId").value="";
 $("tradeForm").reset(); $("fDate").value=new Date().toISOString().slice(0,10); $("fPips").value=0;
 selectedImage=null; $("preview").style.display="none"; $("modal").classList.add("show");
}
function editTrade(id){
 const t=trades.find(x=>x.id===id); if(!t)return;
 $("modalTitle").textContent="Edit trade"; $("editId").value=id;
 $("fDate").value=t.date;$("fSide").value=t.side;$("fOutcome").value=t.outcome;$("fPips").value=t.pips;
 $("fEntry").value=t.entry??"";$("fSL").value=t.sl??"";$("fTP").value=t.tp??"";$("fNum").value=t.num??"";
 $("fReason").value=t.reason||"";$("fSetup").value=t.setup||"";$("fNotes").value=t.notes||"";
 selectedImage=t.image||null;
 $("preview").src=selectedImage||"";$("preview").style.display=selectedImage?"block":"none"; $("fImage").value="";
 $("modal").classList.add("show");
}
function deleteTrade(id){
 if(!confirm("Delete this trade?"))return;
 trades=trades.filter(t=>t.id!==id);save();render();toast("Trade deleted");
}
function toast(msg){$("toast").textContent=msg;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1800)}
function readImage(file){
 return new Promise((resolve,reject)=>{
  if(!file)return resolve(null);
  const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file);
 });
}

$("addBtn").onclick=openAdd;
$("cancelBtn").onclick=()=>$("modal").classList.remove("show");
$("modal").onclick=e=>{if(e.target===$("modal"))$("modal").classList.remove("show")};
["dateFilter","outcomeFilter","sideFilter"].forEach(id=>$(id).onchange=render);
$("clearFilters").onclick=()=>{$("dateFilter").value="all";$("outcomeFilter").value="all";$("sideFilter").value="all";render()};
$("fImage").onchange=async e=>{
 const f=e.target.files[0]; if(!f)return;
 selectedImage=await readImage(f); $("preview").src=selectedImage; $("preview").style.display="block";
};
$("tradeForm").onsubmit=async e=>{
 e.preventDefault();
 const id=$("editId").value||crypto.randomUUID();
 const old=trades.find(t=>t.id===id);
 let num=$("fNum").value;
 if(!num){ const same=trades.filter(t=>t.date===$("fDate").value); num=String(same.length+1); }
 const obj={id,date:$("fDate").value,num,side:$("fSide").value,outcome:$("fOutcome").value,pips:Number($("fPips").value)||0,
   entry:$("fEntry").value===""?"":Number($("fEntry").value),sl:$("fSL").value===""?"":Number($("fSL").value),tp:$("fTP").value===""?"":Number($("fTP").value),
   reason:$("fReason").value.trim(),setup:$("fSetup").value.trim(),notes:$("fNotes").value.trim(),image:selectedImage||(old?.image||"")};
 const i=trades.findIndex(t=>t.id===id); if(i>=0)trades[i]=obj;else trades.push(obj);
 save(); $("modal").classList.remove("show");render();toast(i>=0?"Trade updated":"Trade added");
};
$("exportBtn").onclick=()=>{
 const blob=new Blob([JSON.stringify({version:2,exportedAt:new Date().toISOString(),trades},null,2)],{type:"application/json"});
 const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="xauusd-trade-journal-backup.json";a.click();URL.revokeObjectURL(a.href);
};
$("importBtn").onclick=()=>$("importFile").click();
$("importFile").onchange=()=>{
 const f=$("importFile").files[0];if(!f)return;const r=new FileReader();
 r.onload=()=>{try{const x=JSON.parse(r.result);if(!Array.isArray(x.trades))throw Error();trades=x.trades;save();render();toast("Journal imported")}catch{alert("Invalid journal backup.")}};
 r.readAsText(f);
};

window.editTrade=editTrade;window.deleteTrade=deleteTrade;
if(!localStorage.getItem("xauusd_journal_v2")){ localStorage.setItem("xauusd_journal_v2",JSON.stringify(SEED)); }
render();
</script>
</body>
</html>
